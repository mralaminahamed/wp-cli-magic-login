{
    "name": "mralaminahamed/wp-cli-magic-login",
    "description": "WP-CLI commands for magic login and must-use plugin management on Laravel Valet sites.",
    "type": "wp-cli-package",
    "license": "MIT",
    "homepage": "https://github.com/mralaminahamed/wp-cli-magic-login",
    "authors": [
        {
            "name": "Al Amin Ahamed",
            "email": "mrabir.ahamed@gmail.com",
            "homepage": "https://alaminahamed.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "wp-cli/wp-cli": "^2.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.34",
        "wp-cli/entity-command": "^2",
        "wp-cli/extension-command": "^2",
        "wp-cli/server-command": "^2",
        "wp-cli/wp-cli-tests": "^5"
    },
    "autoload": {
        "psr-4": {
            "WP_CLI_Magic_Login\\": "src/"
        },
        "files": [
            "command.php"
        ]
    },
    "autoload-dev": {
        "classmap": [ "plugin" ],
        "psr-4": {
            "WP_CLI_Magic_Login\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-trunk": "1.x-dev"
        },
        "commands": [
            "magic-login",
            "magic-login install-server"
        ]
    },
    "config": {
        "process-timeout": 7200,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "lock": false
    },
    "scripts": {
        "behat": "run-behat-tests",
        "behat-rerun": "rerun-behat-tests",
        "lint": "run-linter-tests",
        "phpcs": "run-phpcs-tests",
        "phpcbf": "run-phpcbf-cleanup",
        "phpunit": "run-php-unit-tests",
        "prepare-tests": "install-package-tests",
        "test": [
            "@lint",
            "@phpcs",
            "@phpunit",
            "@behat"
        ]
    },
    "support": {
        "issues": "https://github.com/mralaminahamed/wp-cli-magic-login/issues"
    }
}
